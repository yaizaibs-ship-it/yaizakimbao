---
/**
 * Botón «Cuéntame tu proyecto»: se repite por la web y lleva al formulario.
 * perfil (opcional): deja marcada la primera respuesta del formulario.
 */
import { t, url, type Idioma } from '../i18n';

interface Props { lang: Idioma; perfil?: string; texto?: string; clase?: string }
const { lang, perfil, texto, clase } = Astro.props;
const tx = t(lang);
const href = url(lang, 'contacto') + (perfil ? `?perfil=${perfil}` : '') + '#formulario';
---

<a class:list={['boton-proyecto', clase]} href={href}>
  <span class="bp-txt">{texto ?? tx.ui.cuentame}</span>
  <span class="bp-flecha" aria-hidden="true">→</span>
</a>

<style>
  .boton-proyecto {
    display: inline-flex;
    align-items: center;
    gap: 0.7em;
    padding: 0.75em 1.15em 0.8em;
    border-radius: 999px;
    background: var(--color-firma);
    color: #fff;
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1;
    transition: transform 0.5s var(--ease-muelle), background 0.3s;
  }
  .bp-flecha { display: inline-block; transition: transform 0.45s var(--ease); }
  @media (hover: hover) {
    .boton-proyecto:hover { transform: scale(1.04); }
    .boton-proyecto:hover .bp-flecha { transform: translateX(0.3em); }
  }
  .boton-proyecto:active { transform: scale(0.97); }
  .boton-proyecto:focus-visible { outline: 2px solid var(--color-tinta); outline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) {
    .boton-proyecto, .bp-flecha { transition: none; }
  }
</style>
