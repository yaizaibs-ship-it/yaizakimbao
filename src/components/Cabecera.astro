---
import { t, url, type Idioma, type ClaveRuta } from '../i18n';
import { CONTACTO } from '../i18n/comun';

interface Props {
  lang: Idioma;
  actual: ClaveRuta;
  /** URL de esta misma página en el otro idioma */
  urlOtroIdioma: string;
}
const { lang, actual, urlOtroIdioma } = Astro.props;
const tx = t(lang);
const nav: { clave: ClaveRuta; texto: string }[] = [
  { clave: 'inicio', texto: tx.ui.nav.inicio },
  { clave: 'trabajo', texto: tx.ui.nav.trabajo },
  { clave: 'sobre', texto: tx.ui.nav.sobre },
  { clave: 'contacto', texto: tx.ui.nav.contacto },
];
const esActual = (c: ClaveRuta) => c === actual || (actual === 'proyecto' && c === 'trabajo');
const urlEs = lang === 'es' ? Astro.url.pathname : urlOtroIdioma;
const urlEn = lang === 'en' ? Astro.url.pathname : urlOtroIdioma;
// Texto del logo circular (como el sello de Fuego)
const sello = `${CONTACTO.firma} · ${tx.inicio.etiquetas[0]} · `.toUpperCase();
---

<header class="cabecera" data-cabecera>
  <a href={url(lang, 'inicio')} class="sello" aria-label={`${CONTACTO.firma} — ${tx.ui.nav.inicio}`}>
    <svg viewBox="0 0 100 100" aria-hidden="true" data-sello>
      <defs><path id="circulo-sello" d="M50,50 m-38,0 a38,38 0 1,1 76,0 a38,38 0 1,1 -76,0"></path></defs>
      <text><textPath href="#circulo-sello" textLength="236">{sello}</textPath></text>
    </svg>
    <span class="sello-centro" aria-hidden="true">YK</span>
  </a>

  <nav class="nav mini" aria-label="Principal">
    <ul>
      {
        nav.map((n) => (
          <li>
            <a href={url(lang, n.clave)} class="enlace" aria-current={esActual(n.clave) ? 'page' : undefined}>
              {n.texto}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="idiomas mini" role="group" aria-label={tx.ui.idioma}>
    <a href={urlEs} hreflang="es" lang="es" data-cambiar-idioma="es" data-astro-reload aria-current={lang === 'es' ? 'true' : undefined}>ES</a>
    <span aria-hidden="true">|</span>
    <a href={urlEn} hreflang="en" lang="en" data-cambiar-idioma="en" data-astro-reload aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
  </div>

  <button class="boton-menu mini" type="button" aria-expanded="false" aria-controls="menu-movil" data-abrir-menu>
    <span data-texto-abrir>{tx.ui.menu}</span>
    <span data-texto-cerrar hidden>{tx.ui.cerrar}</span>
  </button>
</header>

<div class="menu-movil" id="menu-movil" data-menu-movil hidden>
  <nav aria-label="Principal (móvil)">
    <ul>
      {
        nav.map((n) => (
          <li>
            <a href={url(lang, n.clave)} aria-current={esActual(n.clave) ? 'page' : undefined}>
              {n.texto}.
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="menu-pie">
    <div class="idiomas idiomas--grande" role="group" aria-label={tx.ui.idioma}>
      <a href={urlEs} hreflang="es" lang="es" data-cambiar-idioma="es" data-astro-reload aria-current={lang === 'es' ? 'true' : undefined}>ES</a>
      <span aria-hidden="true">|</span>
      <a href={urlEn} hreflang="en" lang="en" data-cambiar-idioma="en" data-astro-reload aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
    </div>
    <a class="enlace-color" href={`mailto:${CONTACTO.email}`}>{CONTACTO.email} →</a>
  </div>
</div>

<style>
  .cabecera {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: start;
    gap: 2rem;
    padding: 1rem var(--margen) 0;
    color: #fff;
    mix-blend-mode: difference;
    pointer-events: none;
  }
  .cabecera > * { pointer-events: auto; }

  /* Sello circular que gira */
  .sello {
    position: relative;
    display: block;
    width: 4.6rem;
    aspect-ratio: 1;
  }
  .sello svg { width: 100%; height: 100%; overflow: visible; animation: gira 18s linear infinite; }
  .sello text { fill: currentColor; font-size: 9.6px; font-weight: 500; letter-spacing: 0.04em; }
  .sello-centro {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: -0.04em;
  }
  @keyframes gira { to { transform: rotate(360deg); } }

  .nav ul {
    display: flex;
    justify-content: space-around;
    gap: 1.5rem;
    padding-top: 0.6rem;
  }
  .nav a { display: inline-block; }
  .idiomas {
    display: flex;
    gap: 0.4rem;
    padding-top: 0.6rem;
  }
  .idiomas a { opacity: 0.45; transition: opacity 0.3s; }
  .idiomas a[aria-current='true'] { opacity: 1; text-decoration: underline; text-underline-offset: 0.35em; }
  .idiomas a:hover { opacity: 1; }
  .boton-menu { display: none; }

  /* ---- Menú móvil ---- */
  .menu-movil {
    position: fixed;
    inset: 0;
    z-index: 99;
    background: var(--color-tinta);
    color: var(--color-fondo);
    padding: 7.5rem var(--margen) 2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .menu-movil[hidden] { display: none; }
  .menu-movil ul { display: flex; flex-direction: column; gap: 0.2rem; }
  .menu-movil li a {
    display: block;
    font-size: clamp(3rem, 15vw, 5.5rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.055em;
  }
  .menu-movil li a[aria-current='page'] { color: var(--color-firma); }
  .menu-pie { display: flex; justify-content: space-between; align-items: center; }
  .idiomas--grande { font-size: 1rem; }

  @media (max-width: 860px) {
    .cabecera { grid-template-columns: auto 1fr auto; gap: 1rem; }
    .nav { display: none; }
    .sello { width: 3.8rem; }
    .idiomas { justify-self: end; }
    .boton-menu {
      display: block;
      padding: 0.6rem 0 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sello svg { animation: none; }
  }
</style>
