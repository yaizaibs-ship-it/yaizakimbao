---
import { t, url, type Idioma } from '../i18n';
import { CONTACTO } from '../i18n/comun';

interface Props { lang: Idioma }
const { lang } = Astro.props;
const tx = t(lang);
const cinta = tx.pie.cinta;
---

<footer class="pie" id="contacto-pie">
  <p class="sr-only">{cinta.map((c) => c.join(' ')).join(' ')}</p>
  <div class="cinta" aria-hidden="true">
    <div class="cinta-pista" data-cinta>
      {
        [0, 1].map(() => (
          <span class="cinta-grupo">
            {cinta.map(([a, b]) => (
              <>
                <span class="gris-claro">{a}</span> <span>{b}</span>{' '}
              </>
            ))}
          </span>
        ))
      }
    </div>
  </div>

  <div class="pie-cuerpo margen">
    <p class="pie-frase" data-split="palabras">{tx.pie.frase}</p>
    <ul class="pie-lista">
      <li>
        <a href={`mailto:${CONTACTO.email}`}>{CONTACTO.email}</a>
        <span class="enlace-color">{tx.pie.escribeme} ↗</span>
      </li>
      <li>
        <a href={CONTACTO.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      </li>
      <li>
        <a href={CONTACTO.cv[lang]} download>CV (PDF)</a>
        <span class="enlace-color">{tx.pie.descarga} ↓</span>
      </li>
      <li class="gris">{tx.pie.lugar}</li>
    </ul>
  </div>

  <div class="pie-filas mini margen">
    <span>© {new Date().getFullYear()} {CONTACTO.nombre} — {CONTACTO.firma}</span>
    <a class="enlace" href={url(lang, 'contacto')}>{tx.ui.nav.contacto}</a>
    <a class="enlace" href="#top" data-arriba>{tx.ui.volverArriba} ↑</a>
  </div>
</footer>

<style>
  .pie { padding-top: var(--seccion); overflow: hidden; }
  .cinta { overflow: hidden; }
  .cinta-pista {
    display: flex;
    width: max-content;
    animation: cinta 30s linear infinite;
  }
  @media (hover: hover) {
    .cinta:hover .cinta-pista { animation-play-state: paused; }
  }
  .cinta-grupo {
    flex: none;
    padding-right: 0.25em;
    font-size: clamp(4.5rem, 13vw, 14rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.055em;
    white-space: nowrap;
  }
  .gris-claro { color: var(--color-gris); opacity: 0.6; }
  @keyframes cinta { to { transform: translateX(-50%); } }

  .pie-cuerpo { padding-top: clamp(3rem, 10vh, 7rem); }
  .pie-frase {
    max-width: 18ch;
    font-size: clamp(2.2rem, 1rem + 4vw, 5.6rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.05em;
  }
  .pie-lista {
    display: grid;
    gap: 0.5rem;
    margin-top: clamp(2.5rem, 7vh, 4.5rem);
    font-size: clamp(1.25rem, 0.9rem + 1.2vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .pie-lista li { display: flex; align-items: flex-end; gap: 1.2rem; flex-wrap: wrap; }
  @media (hover: hover) {
    .pie-lista a:hover { color: var(--color-firma); }
  }
  .pie-lista .enlace-color { padding-bottom: 0.25em; }

  .pie-filas {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: clamp(4rem, 12vh, 8rem);
    padding-bottom: calc(1.4rem + var(--seguro-abajo));
  }

  @media (max-width: 640px) {
    .pie-filas { flex-direction: column; align-items: flex-start; }
  }
</style>
