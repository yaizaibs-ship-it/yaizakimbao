---
import { t, url, type Idioma } from '../i18n';
import { CONTACTO } from '../i18n/comun';

interface Props { lang: Idioma }
const { lang } = Astro.props;
const tx = t(lang);
const cinta = tx.pie.cinta;
---

<footer class="pie" id="contacto-pie">
  <p class="sr-only">{cinta.map((c) => c.join(' ')).join(' ')}</p>
  <div class="cinta" aria-hidden="true">
    <div class="cinta-pista" data-cinta>
      {
        [0, 1].map(() => (
          <span class="cinta-grupo">
            {cinta.map(([a, b]) => (
              <>
                <span class="gris-claro">{a}</span> <span>{b}</span>{' '}
              </>
            ))}
          </span>
        ))
      }
    </div>
  </div>

  <div class="pie-cuerpo margen">
    <p class="pie-frase" data-split="palabras">{tx.pie.frase}</p>
    <ul class="pie-lista">
      <li>
        <a href={`mailto:${CONTACTO.email}`}>{CONTACTO.email}</a>
        <span class="enlace-color">{tx.pie.escribeme} ↗</span>
      </li>
      <li>
        <a href={CONTACTO.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      </li>
      <li>
        <a href={CONTACTO.cv[lang]} download>CV (PDF)</a>
        <span class="enlace-color">{tx.pie.descarga} ↓</span>
      </li>
      <li class="gris">{tx.pie.lugar}</li>
    </ul>
  </div>

  <div class="pie-web margen">
    <p class="pie-web-texto">{tx.pie.hechaPorMi}</p>
    <a
      class="pie-web-cta"
      href={`mailto:${CONTACTO.email}?subject=${encodeURIComponent(tx.pie.asuntoWeb)}`}
    >
      <span class="sr-only">{tx.pie.quieresUna} {tx.pie.quieresUnaHover}</span>
      <span class="rodillo" aria-hidden="true">
        <span class="rodillo-fila">{tx.pie.quieresUna}</span>
        <span class="rodillo-fila rodillo-oculta">{tx.pie.quieresUnaHover} <span class="flecha">→</span></span>
      </span>
    </a>
    <a class="enlace-color" href={url(lang, 'proyecto', 'esta-web')}>{tx.pie.comoLaHice} ↗</a>
  </div>

  <div class="pie-filas mini margen">
    <span>© {new Date().getFullYear()} {CONTACTO.nombre} — {CONTACTO.firma}</span>
    <a class="enlace" href={url(lang, 'contacto')}>{tx.ui.nav.contacto}</a>
    <a class="enlace" href="#top" data-arriba>{tx.ui.volverArriba} ↑</a>
  </div>
</footer>

<style>
  .pie { padding-top: var(--seccion); overflow: hidden; }
  .cinta { overflow: hidden; }
  .cinta-pista {
    display: flex;
    width: max-content;
    animation: cinta 30s linear infinite;
  }
  @media (hover: hover) {
    .cinta:hover .cinta-pista { animation-play-state: paused; }
  }
  .cinta-grupo {
    flex: none;
    padding-right: 0.25em;
    font-size: clamp(4.5rem, 13vw, 14rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.055em;
    white-space: nowrap;
  }
  .gris-claro { color: var(--color-gris); opacity: 0.6; }
  @keyframes cinta { to { transform: translateX(-50%); } }

  .pie-cuerpo { padding-top: clamp(3rem, 10vh, 7rem); }
  .pie-frase {
    max-width: 18ch;
    font-size: clamp(2.2rem, 1rem + 4vw, 5.6rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.05em;
  }
  .pie-lista {
    display: grid;
    gap: 0.5rem;
    margin-top: clamp(2.5rem, 7vh, 4.5rem);
    font-size: clamp(1.25rem, 0.9rem + 1.2vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .pie-lista li { display: flex; align-items: flex-end; gap: 1.2rem; flex-wrap: wrap; }
  @media (hover: hover) {
    .pie-lista a:hover { color: var(--color-firma); }
  }
  .pie-lista .enlace-color { padding-bottom: 0.25em; }

  /* ---- «Esta web la he hecho yo» ----
     Al pasar el ratón, la pregunta sube y entra «Escríbeme…» en magenta.
     Solo pasa con el ratón encima (o con el teclado): el resto del tiempo está quieta. */
  .pie-web {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.35em 0.6em;
    padding-top: clamp(3rem, 9vh, 6rem);
    font-size: var(--t-medio);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .pie-web-texto { color: var(--color-gris); }
  .pie-web .enlace-color { align-self: center; margin-left: 0.4em; }
  .pie-web-cta { display: inline-block; }
  .rodillo {
    display: inline-grid;
    overflow: hidden;
    height: 1.15em;
    vertical-align: bottom;
  }
  .rodillo-fila {
    grid-area: 1 / 1;
    white-space: nowrap;
    transition: transform 0.55s var(--ease);
  }
  .rodillo-oculta {
    color: var(--color-firma);
    transform: translateY(110%);
  }
  .flecha { display: inline-block; transition: transform 0.55s var(--ease) 0.08s; }
  .pie-web-cta:hover .rodillo-fila:first-child,
  .pie-web-cta:focus-visible .rodillo-fila:first-child { transform: translateY(-110%); }
  .pie-web-cta:hover .rodillo-oculta,
  .pie-web-cta:focus-visible .rodillo-oculta { transform: translateY(0); }
  .pie-web-cta:hover .flecha { transform: translateX(0.25em); }
  /* En móvil no hay ratón: se ve la pregunta subrayada en magenta */
  @media (hover: none) {
    .pie-web-cta .rodillo-fila:first-child {
      text-decoration: underline;
      text-decoration-color: var(--color-firma);
      text-underline-offset: 0.18em;
      text-decoration-thickness: 2px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rodillo-fila, .flecha { transition: none; }
  }

  .pie-filas {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: clamp(4rem, 12vh, 8rem);
    padding-bottom: calc(1.4rem + var(--seguro-abajo));
  }

  @media (max-width: 640px) {
    .pie-filas { flex-direction: column; align-items: flex-start; }
  }
</style>
