---
/**
 * MURO DE MARCAS (home)
 * Lista y enlaces en src/i18n/comun.ts → MARCAS.
 * Logos opcionales en src/assets/marcas/<clave>.svg|png (si no hay, sale el nombre escrito).
 * Textos en es.ts / en.ts → inicio.marcas
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BotonProyecto from './BotonProyecto.astro';
import { t, url, type Idioma } from '../i18n';
import { MARCAS } from '../i18n/comun';

interface Props { lang: Idioma }
const { lang } = Astro.props;
const m = t(lang).inicio.marcas;

const archivos = import.meta.glob<ImageMetadata>('../assets/marcas/*.{svg,png,jpg,webp}', { eager: true, import: 'default' });
const logoDe = (clave: string) => {
  const k = Object.keys(archivos).find((r) => r.split('/').pop()!.replace(/\.\w+$/, '') === clave);
  return k ? archivos[k] : undefined;
};
---

<section class="marcas margen" aria-labelledby="titulo-marcas">
  <div class="mc-cabeza">
    <p class="mini">{m.etiqueta}</p>
    <h2 id="titulo-marcas" class="mc-h" data-reveal>{m.titulo}</h2>
  </div>

  <ul class="mc-muro">
    {
      MARCAS.map((b) => {
        const logo = logoDe(b.clave);
        const href = b.caso ? url(lang, 'proyecto', b.caso) : b.web;
        const externo = !b.caso && !!b.web;
        const contenido = logo ? (
          <Image src={logo} alt={b.nombre} class="mc-logo" widths={[240, 480]} sizes="240px" />
        ) : (
          <span class="mc-nombre">{b.nombre}</span>
        );
        return (
          <li class="mc-celda" data-reveal>
            {href ? (
              <a class="mc-a" href={href} {...(externo ? { target: '_blank', rel: 'noopener' } : {})}>
                {contenido}
                <span class="mc-flecha" aria-hidden="true">{externo ? '↗' : '→'}</span>
              </a>
            ) : (
              <div class="mc-a">{contenido}</div>
            )}
          </li>
        );
      })
    }
  </ul>

  <div class="mc-pie">
    <p class="mc-nota" data-reveal>{m.nota}</p>
    <div data-reveal><BotonProyecto lang={lang} /></div>
  </div>
</section>

<style>
  .marcas { padding-block: var(--seccion); }
  .mc-cabeza { display: grid; gap: 1rem; margin-bottom: clamp(2rem, 5vh, 3.5rem); }
  .mc-h { max-width: 16ch; font-size: var(--t-grande); font-weight: 500; line-height: 0.95; letter-spacing: -0.05em; }

  .mc-muro {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--color-linea);
    border-left: 1px solid var(--color-linea);
  }
  .mc-celda { border-right: 1px solid var(--color-linea); border-bottom: 1px solid var(--color-linea); }
  .mc-a {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: clamp(7.5rem, 13vw, 11rem);
    height: 100%;
    padding: 1.4rem;
    text-align: center;
    transition: background 0.35s, color 0.35s;
  }
  .mc-nombre {
    max-width: 14ch;
    font-size: clamp(1.05rem, 0.8rem + 0.8vw, 1.6rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.035em;
  }
  /* Los logos se pintan en el color del texto para que todos combinen */
  .mc-a :global(.mc-logo) { width: auto; max-width: 70%; max-height: 3.4rem; object-fit: contain; filter: brightness(0); }
  :global(body.oscuro) .mc-a :global(.mc-logo) { filter: brightness(0) invert(1); }
  .mc-flecha { position: absolute; top: 0.8rem; right: 0.9rem; font-size: var(--t-peque); opacity: 0.5; transition: opacity 0.3s, transform 0.4s var(--ease); }
  @media (hover: hover) {
    a.mc-a:hover { background: var(--color-firma); color: #fff; }
    a.mc-a:hover :global(.mc-logo) { filter: brightness(0) invert(1); }
    a.mc-a:hover .mc-flecha { opacity: 1; transform: translate(0.15rem, -0.15rem); }
  }
  a.mc-a:focus-visible { outline: 2px solid var(--color-firma); outline-offset: -2px; }

  .mc-pie { display: flex; justify-content: space-between; align-items: flex-end; gap: 2rem; flex-wrap: wrap; margin-top: clamp(1.8rem, 4vh, 3rem); }
  .mc-nota { max-width: 52ch; color: var(--color-gris); font-size: var(--t-cuerpo); line-height: 1.3; letter-spacing: -0.015em; }

  @media (max-width: 860px) {
    .mc-muro { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .mc-a { min-height: 6.5rem; padding: 1rem; }
  }
</style>
