---
/**
 * SERVICIOS SEGÚN QUIÉN LLEGA (home)
 * Tres tarjetas: negocio local / marca / agencia. Al pulsar, se despliega
 * una «notita» magenta con lo que puedo hacer y el botón al formulario.
 * Textos en es.ts / en.ts → inicio.servicios
 */
import BotonProyecto from './BotonProyecto.astro';
import { t, type Idioma } from '../i18n';

interface Props { lang: Idioma }
const { lang } = Astro.props;
const s = t(lang).inicio.servicios;
---

<section class="servicios margen" aria-labelledby="titulo-servicios">
  <div class="sv-cabeza">
    <p class="mini">{s.etiqueta}</p>
    <h2 id="titulo-servicios" class="titular sv-h"><span data-split="letras">{s.titulo}</span></h2>
    <p class="sv-intro" data-reveal>{s.intro}</p>
  </div>

  <ul class="sv-lista">
    {
      s.perfiles.map((p, i) => (
        <li class="sv-item" data-reveal>
          <details class="sv-tarjeta" name="servicios">
            <summary class="sv-resumen">
              <span class="mini sv-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="sv-titulo">{p.titulo}</span>
              <span class="sv-texto">{p.resumen}</span>
              <span class="sv-abrir">
                <span class="sv-mas" aria-hidden="true" />
                <span class="sv-abrir-txt">{s.abrir}</span>
              </span>
            </summary>
            <div class="sv-nota">
              <p class="mini sv-nota-et">({s.nota})</p>
              <ul class="sv-nota-lista">
                {p.lista.map((x) => <li>{x}</li>)}
              </ul>
              <BotonProyecto lang={lang} perfil={p.clave} clase="sv-boton" />
            </div>
          </details>
        </li>
      ))
    }
  </ul>
</section>

<script>
  /*
   * Apertura y cierre fluidos (como las hojas de iOS).
   * El <details> nativo abre y cierra de golpe: aquí se anima su altura con la
   * curva de iOS, la notita entra y sale suave y, si se cierra otra tarjeta
   * que queda por encima (en el móvil), la pantalla no pega saltos.
   */
  const CURVA = 'cubic-bezier(0.32, 0.72, 0, 1)';
  const ABRE = 650;
  const CIERRA = 520;
  const anims = new WeakMap<HTMLDetailsElement, Animation>();

  const reducir = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
  const avisa = () => document.dispatchEvent(new CustomEvent('contenido:cambia'));

  function mueve(d: HTMLDetailsElement, abrir: boolean, alTerminar?: () => void) {
    const resumen = d.querySelector('summary')!;
    const nota = d.querySelector<HTMLElement>('.sv-nota');
    anims.get(d)?.cancel();
    nota?.getAnimations().forEach((x) => { if (!(x instanceof CSSAnimation)) x.cancel(); });
    const desde = d.offsetHeight;
    if (abrir) d.open = true;
    const borde = parseFloat(getComputedStyle(d).borderTopWidth) || 0;
    const hasta = (abrir ? d.scrollHeight : resumen.offsetHeight) + borde;
    if (reducir()) {
      if (!abrir) d.open = false;
      alTerminar?.();
      avisa();
      return;
    }
    d.classList.add('anima');
    d.dataset.estado = abrir ? 'abriendo' : 'cerrando';
    const a = d.animate([{ height: `${desde}px` }, { height: `${hasta}px` }], {
      duration: abrir ? ABRE : CIERRA,
      easing: CURVA,
    });
    if (!abrir && nota) {
      nota.animate(
        [{ opacity: 1, transform: 'rotate(-0.6deg)' }, { opacity: 0, transform: 'translateY(-0.8rem) rotate(-1.6deg) scale(0.97)' }],
        { duration: CIERRA * 0.7, easing: CURVA, fill: 'forwards' },
      );
    }
    anims.set(d, a);
    a.onfinish = () => {
      if (!abrir) {
        d.open = false;
        nota?.getAnimations().forEach((x) => x.cancel());
      }
      d.classList.remove('anima');
      delete d.dataset.estado;
      anims.delete(d);
      alTerminar?.();
      avisa();
    };
    a.oncancel = () => {
      if (anims.get(d) !== a) return;
      d.classList.remove('anima');
      anims.delete(d);
    };
    return a;
  }

  function iniciaServicios() {
    const tarjetas = Array.from(document.querySelectorAll<HTMLDetailsElement>('.sv-tarjeta'));
    for (const d of tarjetas) {
      if (d.dataset.listo) continue;
      d.dataset.listo = '1';
      // Quitamos el «name» para que el navegador no cierre las demás de golpe: lo hacemos nosotras
      d.removeAttribute('name');
      d.querySelector('summary')!.addEventListener('click', (e) => {
        e.preventDefault();
        const abierta = d.open && d.dataset.estado !== 'cerrando';
        if (abierta) {
          mueve(d, false);
          return;
        }
        const arriba = d.getBoundingClientRect().top;
        // Cerrar la que estuviera abierta
        for (const otra of tarjetas) {
          if (otra === d || !otra.open || otra.dataset.estado === 'cerrando') continue;
          const encima = otra.getBoundingClientRect().bottom <= arriba + 1;
          const a = mueve(otra, false);
          // Si está encima (móvil), se compensa el scroll para que la tarjeta pulsada no salte
          if (a && encima) {
            let antes = otra.offsetHeight;
            const sigue = () => {
              const ahora = otra.offsetHeight;
              if (ahora !== antes) window.scrollBy(0, ahora - antes);
              antes = ahora;
              if (anims.get(otra) === a) requestAnimationFrame(sigue);
            };
            requestAnimationFrame(sigue);
          } else if (!a && encima) {
            window.scrollTo(0, window.scrollY - (arriba - d.getBoundingClientRect().top));
          }
        }
        mueve(d, true);
      });
    }
  }

  document.addEventListener('astro:page-load', iniciaServicios);
</script>

<style>
  .servicios { padding-block: var(--seccion); }
  .sv-cabeza { display: grid; gap: 1.2rem; margin-bottom: clamp(2.5rem, 7vh, 5rem); }
  .sv-h { font-size: var(--t-grande); line-height: 0.95; }
  .sv-intro { max-width: 34ch; font-size: var(--t-medio); line-height: 1.12; letter-spacing: -0.02em; font-weight: 500; }

  .sv-lista { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--hueco); align-items: start; }
  .sv-tarjeta { border-top: 1px solid var(--color-tinta); }
  .sv-resumen {
    display: grid;
    gap: 0.7rem;
    padding-top: 1rem;
    padding-bottom: 1.2rem;
    cursor: pointer;
    list-style: none;
  }
  .sv-resumen::-webkit-details-marker { display: none; }
  .sv-titulo {
    font-size: clamp(1.7rem, 1rem + 2.1vw, 3.1rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.045em;
    transition: color 0.3s var(--ease-ios);
  }
  .sv-texto { max-width: 30ch; color: var(--color-gris); font-size: var(--t-cuerpo); line-height: 1.3; letter-spacing: -0.015em; }
  .sv-abrir { display: inline-flex; align-items: center; gap: 0.6rem; margin-top: 0.4rem; font-size: 0.9375rem; font-weight: 500; letter-spacing: -0.02em; }
  /* El «+» gira y se convierte en «×» al abrir */
  .sv-mas {
    position: relative;
    width: 1.6rem;
    height: 1.6rem;
    border: 1px solid currentColor;
    border-radius: 50%;
    flex: none;
    transition: transform 0.5s var(--ease-muelle), background 0.3s var(--ease-ios), border-color 0.3s var(--ease-ios);
  }
  .sv-mas::before, .sv-mas::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.75rem;
    height: 1.5px;
    background: currentColor;
    transform: translate(-50%, -50%);
  }
  .sv-mas::after { transform: translate(-50%, -50%) rotate(90deg); }
  .sv-tarjeta[open] .sv-mas { transform: rotate(45deg); background: var(--color-firma); border-color: var(--color-firma); color: #fff; }
  @media (hover: hover) {
    .sv-resumen:hover .sv-titulo { color: var(--color-firma); }
  }
  .sv-resumen:focus-visible { outline: 2px solid var(--color-firma); outline-offset: 4px; }

  /* La notita */
  .sv-tarjeta.anima { overflow: hidden; }
  .sv-nota {
    position: relative;
    margin: 0.9rem 0 1.5rem;
    padding: 1.4rem 1.4rem 1.6rem;
    border-radius: 0.4rem;
    background: var(--color-firma);
    color: #fff;
    transform-origin: top left;
    animation: nota 0.75s var(--ease-ios) both;
  }
  .sv-nota::before {
    /* trocito de cinta adhesiva */
    content: '';
    position: absolute;
    top: -0.55rem;
    left: 1.4rem;
    width: 3.6rem;
    height: 1.1rem;
    background: color-mix(in srgb, var(--color-fondo) 70%, transparent);
    transform: rotate(-4deg);
  }
  .sv-nota-et { opacity: 0.8; margin-bottom: 0.9rem; }
  .sv-nota-lista { display: grid; gap: 0.55rem; margin-bottom: 1.5rem; font-size: var(--t-cuerpo); line-height: 1.25; letter-spacing: -0.015em; }
  .sv-nota-lista li { padding-left: 1.1em; text-indent: -1.1em; }
  .sv-nota-lista li::before { content: '→ '; }
  .sv-nota :global(.sv-boton) { background: #fff; color: var(--color-firma); }
  @keyframes nota {
    from { opacity: 0; transform: translateY(-1.2rem) rotate(-2.4deg) scale(0.96); }
    to { opacity: 1; transform: rotate(-0.6deg); }
  }

  @media (max-width: 860px) {
    .sv-lista { grid-template-columns: 1fr; gap: 0; }
    .sv-titulo { font-size: clamp(1.9rem, 8vw, 2.6rem); }
  }
  @media (prefers-reduced-motion: reduce) {
    .sv-nota { animation: none; }
    .sv-mas { transition: none; }
  }
</style>
