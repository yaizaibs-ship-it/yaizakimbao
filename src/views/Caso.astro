---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import { t, url, otroIdioma, type Idioma } from '../i18n';
import { getProyectos } from '../lib/proyectos';
import { buscaImagen } from '../lib/imagenes';

interface Props { lang: Idioma; slug: string }
const { lang, slug } = Astro.props;
const tx = t(lang);
const lista = await getProyectos(lang);
const i = lista.findIndex((x) => x.slug === slug);
const p = lista[i];
const sig = lista[(i + 1) % lista.length];
const { Content } = await render(p.entrada);
const carpeta = `proyectos/${p.slug}`;
const [primera, ...resto] = p.galeria;
const nombreGaleria = (n: number) => `Galería ${p.titulo} ${n}`;
/** Las imágenes muy verticales (stories 9:16) van de tres en tres */
const esEstrecha = (pr: string) => {
  const [a, b] = pr.split(':').map(Number);
  return a > 0 && b > 0 && a / b < 0.7;
};
---

<Base
  lang={lang}
  actual="proyecto"
  urlOtroIdioma={url(otroIdioma(lang), 'proyecto', p.slug)}
  titulo={p.titulo}
  descripcion={p.descripcion}
  imagenOG={buscaImagen(carpeta, 'portada')}
  acento={p.color}
  acentoTexto={p.colorTexto}
  proyecto={{ anio: p.anio, cliente: p.cliente, disciplinas: p.disciplinas }}
>
  <article class="caso">
    <!-- Cabecera: la portada de la tarjeta crece hasta aquí y luego se reduce -->
    <header class="caso-portada" data-encoge>
      <div class="caso-portada-img" data-encoge-img>
        <Foto
          carpeta={carpeta}
          archivo="portada"
          etiqueta={`Portada ${p.titulo} (cabecera, recomendada 16:9)`}
          alt={p.portadaAlt}
          color={p.color}
          colorTexto={p.colorTexto}
          sizes="100vw"
          ancho={2600}
          carga="eager"
          transitionName={`portada-${p.slug}`}
          posicion={p.portadaPosicion}
        />
      </div>
    </header>

    <section class="caso-intro">
      <div class="margen">
        <p class="mini intro-n">({String(i + 1).padStart(2, '0')}/{String(lista.length).padStart(2, '0')}) — {tx.ui.nav.trabajo}</p>
        <h1 class="titular caso-h"><span data-fit="1" data-fit-max="30vh" data-split="letras">{p.titulo}</span></h1>
        <div class="intro-grid">
          <p class="caso-desc" data-split="palabras">{p.descripcion}</p>
          <dl class="ficha mini" data-reveal>
            {p.anio && (<div><dt>{tx.ui.ficha.anio}</dt><dd>{p.anio}</dd></div>)}
            {p.cliente && (<div><dt>{tx.ui.ficha.cliente}</dt><dd>{p.cliente}</dd></div>)}
            {p.rol && (<div><dt>{tx.ui.ficha.rol}</dt><dd>{p.rol}</dd></div>)}
            {p.disciplinas.length > 0 && (<div><dt>{tx.ui.ficha.disciplinas}</dt><dd>{p.disciplinas.map((d) => tx.ui.disciplinas[d]).join(', ')}</dd></div>)}
            {p.enlaces.length > 0 && (
              <div>
                <dt>{tx.ui.ficha.enlaces}</dt>
                <dd>{p.enlaces.map((e) => <a class="enlace" href={e.url} target="_blank" rel="noopener">{e.texto} ↗</a>)}</dd>
              </div>
            )}
          </dl>
        </div>
        {p.sinTraducir && <p class="mini aviso">{tx.ui.soloEspanol}</p>}
      </div>
    </section>

    <div class="caso-cuerpo margen" lang={p.sinTraducir ? 'es' : undefined}>
      <Content />
    </div>

    {
      p.videos.length > 0 && (
        <section class="videos margen" aria-label={tx.ui.videos}>
          {p.videos.map((v) => (
            <figure class:list={['video', { 'video--vertical': v.vertical }]} data-reveal>
              <div class="video-marco">
                <iframe
                  src={v.embed}
                  title={v.titulo ?? `${p.titulo} — ${v.plataforma}`}
                  loading="lazy"
                  allow="autoplay; encrypted-media; fullscreen; picture-in-picture"
                  allowfullscreen
                  referrerpolicy="strict-origin-when-cross-origin"
                ></iframe>
              </div>
              <figcaption class="video-pie">
                {v.titulo && <span class="video-titulo">{v.titulo}</span>}
                <a class="enlace-color" href={v.url} target="_blank" rel="noopener">{tx.ui.verEn} {v.plataforma} ↗</a>
              </figcaption>
            </figure>
          ))}
        </section>
      )
    }

    {
      primera && (
        <section class="galeria" aria-label={tx.ui.galeria}>
          <div class="crece" data-crece>
            <div class="crece-media" data-crece-media>
              <Foto
                carpeta={carpeta}
                archivo={primera.archivo}
                etiqueta={`${nombreGaleria(1)} — ${primera.proporcion} (se muestra a pantalla completa)`}
                alt={primera.alt}
                color={p.color}
                colorTexto={p.colorTexto}
                sizes="100vw"
                ancho={2600}
              />
            </div>
            <span class="mini crece-pie" data-crece-pie>{tx.ui.galeria} ↓</span>
          </div>
          {resto.length > 0 && <div class="rejilla margen">
            {resto.map((g, n) => (
              <figure class:list={['rejilla-item', { ancha: g.ancha, estrecha: esEstrecha(g.proporcion) }]} data-reveal>
                <Foto
                  carpeta={carpeta}
                  archivo={g.archivo}
                  proporcion={g.proporcion}
                  etiqueta={nombreGaleria(n + 2)}
                  alt={g.alt}
                  color={p.color}
                  colorTexto={p.colorTexto}
                  sizes={g.ancha ? '100vw' : '(min-width: 861px) 48vw, 100vw'}
                />
              </figure>
            ))}
          </div>}
        </section>
      )
    }

    {
      p.bloques.map((b, i) => (
        <section
          class:list={['bloque', { 'bloque--color': b.fondo }]}
          style={b.fondo ? `--bloque-fondo:${b.fondo};--bloque-texto:${b.colorTexto ?? 'inherit'}` : undefined}
          aria-labelledby={`bloque-${i}`}
        >
          <div class="margen">
            {b.cita && (
              <p class="bloque-cita" data-split="palabras">{b.cita}</p>
            )}
            <header class="bloque-cab" data-reveal>
              <span class="mini bloque-n">{b.etiqueta ?? `(${String(i + 1).padStart(2, '0')})`}</span>
              <h2 id={`bloque-${i}`} class="bloque-h">{b.titulo}</h2>
              {b.texto && <p class="bloque-txt">{b.texto}</p>}
            </header>
            {b.piezas.length > 0 && (
              <div class="mosaico">
                {b.piezas.map((pz) => (
                  <figure class:list={['pieza', `pieza--${pz.tamano}`, { 'pieza--desfase': pz.desfase }]} data-reveal>
                    {pz.video ? (
                      <div class="pieza-video" style={`aspect-ratio:${pz.proporcion.replace(':', ' / ')}`}>
                        <iframe
                          src={pz.video.embed}
                          title={pz.alt || `${p.titulo} — ${pz.video.plataforma}`}
                          loading="lazy"
                          allow="autoplay; encrypted-media; fullscreen; picture-in-picture"
                          allowfullscreen
                          referrerpolicy="strict-origin-when-cross-origin"
                        ></iframe>
                      </div>
                    ) : (
                      <Foto
                        carpeta={carpeta}
                        archivo={pz.archivo ?? ''}
                        proporcion={pz.proporcion}
                        etiqueta={`${b.titulo} — ${pz.archivo}`}
                        alt={pz.alt}
                        color={p.color}
                        colorTexto={p.colorTexto}
                        sizes={pz.tamano === 'completo' ? '100vw' : '(min-width: 861px) 50vw, 100vw'}
                      />
                    )}
                    {(pz.pie || pz.video) && (
                      <figcaption class="mini pieza-pie">
                        {pz.pie && <span>{pz.pie}</span>}
                        {pz.video && <a class="enlace" href={pz.video.url} target="_blank" rel="noopener">{tx.ui.verEn} {pz.video.plataforma} ↗</a>}
                      </figcaption>
                    )}
                  </figure>
                ))}
              </div>
            )}
          </div>
        </section>
      ))
    }

    <nav class="siguiente" style={`--sig:${sig.color};--sig-texto:${sig.colorTexto}`} aria-label={tx.ui.siguiente}>
      <a href={url(lang, 'proyecto', sig.slug)} class="sig-a" data-cursor={tx.ui.ver}>
        <span class="mini">{tx.ui.siguiente} →</span>
        <span class="titular sig-t"><span data-fit="1" data-fit-max="28vh">{sig.titulo}</span></span>
      </a>
    </nav>
  </article>
</Base>

<style>
  .caso-portada { position: relative; height: 100vh; height: 100svh; overflow: hidden; }
  .caso-portada-img { position: absolute; inset: 0; transform-origin: 50% 0%; }

  .caso-intro { background: var(--accent); color: var(--accent-texto); padding-block: 2.5rem 3rem; margin-top: -1px; }
  .intro-n { margin-bottom: 1.5rem; }
  .caso-h { display: block; }
  .intro-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 3rem; margin-top: 2.5rem; align-items: start; }
  .caso-desc { font-size: var(--t-medio); line-height: 1.12; letter-spacing: -0.02em; font-weight: 500; max-width: 30ch; }
  .ficha { display: grid; gap: 0.8rem; }
  .ficha div { display: grid; grid-template-columns: 7rem 1fr; gap: 1rem; border-top: 1px solid currentColor; padding-top: 0.6rem; }
  .ficha dt { opacity: 0.65; }
  .ficha dd { display: flex; flex-direction: column; gap: 0.2rem; }
  .aviso { margin-top: 2rem; opacity: 0.8; }

  /* ---- Cuerpo del caso (markdown) ---- */
  .caso-cuerpo { counter-reset: seccion; padding-block: var(--seccion) 2rem; }
  .caso-cuerpo :global(h2) {
    counter-increment: seccion;
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 2rem;
    align-items: baseline;
    margin-top: clamp(2.5rem, 6vh, 4rem);
    padding-top: 0.8rem;
    border-top: 1px solid var(--color-tinta);
    font-size: clamp(1.9rem, 3.8vw, 4rem);
    font-weight: 500;
    line-height: 0.92;
    letter-spacing: -0.055em;
  }
  .caso-cuerpo :global(h2::before) {
    content: '(' counter(seccion, decimal-leading-zero) ')';
    letter-spacing: 0.02em;
    font-size: var(--t-mini);
    font-weight: 500;
    letter-spacing: 0.03em;
    color: var(--accent);
    filter: saturate(1.2);
  }
  .caso-cuerpo :global(h2:first-child) { margin-top: 0; }
  .caso-cuerpo :global(p), .caso-cuerpo :global(ul) {
    margin-left: calc(33.333% + 0.7rem);
    margin-top: 1rem;
    max-width: 52ch;
    font-size: var(--t-cuerpo);
    line-height: 1.38;
    letter-spacing: -0.01em;
  }
  .caso-cuerpo :global(ul) { list-style: none; }
  .caso-cuerpo :global(li) { padding-left: 1.2em; position: relative; }
  .caso-cuerpo :global(li::before) { content: '—'; position: absolute; left: 0; color: var(--accent); }
  .caso-cuerpo :global(strong) { font-weight: 600; }
  .caso-cuerpo :global(a) { text-decoration: underline; text-underline-offset: 0.15em; }
  /* Citas (reseñas, testimonios): > en el markdown */
  .caso-cuerpo :global(blockquote) {
    margin: 2rem 0 0 calc(33.333% + 0.7rem);
    max-width: 22ch;
    font-size: clamp(1.3rem, 2.2vw, 2.2rem);
    line-height: 1;
    letter-spacing: -0.045em;
  }
  .caso-cuerpo :global(blockquote p) { margin: 0; max-width: none; font-size: inherit; line-height: inherit; letter-spacing: inherit; }
  .caso-cuerpo :global(blockquote p::before) { content: '«'; color: var(--accent); }
  .caso-cuerpo :global(blockquote p::after) { content: '»'; color: var(--accent); }

  /* ---- Vídeos de redes ---- */
  .videos { display: flex; flex-wrap: wrap; justify-content: center; gap: 2rem; padding-top: var(--seccion); }
  .video { width: min(100%, 60rem); }
  .video--vertical { width: min(100%, 23rem); }
  .video-marco { position: relative; aspect-ratio: 16 / 9; background: var(--accent); border-radius: 0.5rem; overflow: hidden; }
  .video--vertical .video-marco { aspect-ratio: 9 / 16; }
  .video-marco iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .video-pie { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-top: 0.8rem; }
  .video-titulo { font-size: 0.95rem; letter-spacing: -0.01em; }

  /* ---- Galería ---- */
  .galeria { padding-top: var(--seccion); }
  .crece { position: relative; height: 100vh; height: 100svh; }
  .crece-media { position: absolute; inset: 0; }
  .crece-pie { position: absolute; left: 50%; bottom: calc(1.5rem + var(--seguro-abajo)); transform: translateX(-50%); }
  .rejilla { display: grid; grid-template-columns: repeat(6, 1fr); gap: var(--hueco); padding-top: var(--hueco); align-items: start; }
  .rejilla-item { grid-column: span 3; }
  .rejilla-item.ancha { grid-column: 1 / -1; }
  .rejilla-item.estrecha { grid-column: span 2; }
  .rejilla-item:nth-child(4n + 2):not(.ancha):not(.estrecha) { margin-top: 10vh; }

  /* ---- Bloques en mosaico ---- */
  .bloque { padding-top: var(--seccion); }
  /* Bloque con color propio: va a sangre y lleva su propio aire arriba y abajo */
  .bloque--color {
    margin-top: var(--seccion);
    padding-block: clamp(2.5rem, 7vh, 5rem);
    background: var(--bloque-fondo);
    color: var(--bloque-texto);
  }
  .bloque--color + .bloque--color { margin-top: 0; }
  .bloque-cita {
    max-width: 18ch;
    margin-bottom: clamp(2rem, 5vh, 4rem);
    font-size: clamp(2.2rem, 1rem + 4.4vw, 6rem);
    font-weight: 500;
    line-height: 0.88;
    letter-spacing: -0.06em;
    text-wrap: balance;
  }
  .bloque-cab {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 0.6rem 2rem;
    align-items: baseline;
    padding-top: 1rem;
    border-top: 1px solid currentColor;
    margin-bottom: clamp(1.2rem, 3vh, 2.2rem);
  }
  .bloque-n { color: var(--accent); filter: saturate(1.2); }
  .bloque--color .bloque-n { color: inherit; filter: none; }
  .bloque-h { font-size: clamp(1.9rem, 3.8vw, 4rem); font-weight: 500; line-height: 0.9; letter-spacing: -0.055em; }
  .bloque-txt { grid-column: 2; max-width: 52ch; font-size: var(--t-cuerpo); line-height: 1.38; letter-spacing: -0.01em; }
  .mosaico { display: grid; grid-template-columns: repeat(12, 1fr); gap: var(--hueco); align-items: start; }
  .pieza { grid-column: span 6; }
  .pieza--completo { grid-column: 1 / -1; }
  .pieza--dostercios { grid-column: span 8; }
  .pieza--tercio { grid-column: span 4; }
  .pieza--cuarto { grid-column: span 3; }
  .pieza--sexto { grid-column: span 2; }
  .pieza--desfase { margin-top: clamp(2rem, 8vh, 6rem); }
  .pieza :global(.foto) { border-radius: 0.35rem; }
  .pieza-video { position: relative; border-radius: 0.35rem; overflow: hidden; background: var(--color-oscuro); }
  .pieza-video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .pieza-pie { display: flex; justify-content: space-between; gap: 1rem; margin-top: 0.6rem; opacity: 0.8; }

  /* ---- Siguiente proyecto ---- */
  .siguiente { margin-top: var(--seccion); }
  .sig-a {
    display: block;
    padding: 2.4rem var(--margen) 2rem;
    background: var(--sig);
    color: var(--sig-texto);
    overflow: hidden;
  }
  .sig-t { display: block; margin-top: 1rem; transition: transform 0.7s var(--ease); }
  @media (hover: hover) {
    .sig-a:hover .sig-t { transform: translateX(1.5rem); }
  }

  @media (max-width: 860px) {
    /* En móvil, la portada y la imagen grande se ven enteras sobre el color del proyecto */
    .caso-portada :global(img), .crece-media :global(img) { object-fit: contain; }
    .caso-portada { height: auto; aspect-ratio: 3 / 2; margin-top: calc(var(--cabecera) - 1rem); }
    .crece { height: auto; aspect-ratio: 8 / 5; }
    .intro-grid { grid-template-columns: 1fr; gap: 2rem; }
    .caso-cuerpo :global(h2) { grid-template-columns: 1fr; gap: 0.6rem; }
    .caso-cuerpo :global(p), .caso-cuerpo :global(ul) { margin-left: 0; }
    .caso-cuerpo :global(blockquote) { margin-left: 0; }
    .bloque-cab { grid-template-columns: 1fr; }
    .bloque-txt { grid-column: 1; }
    .pieza, .pieza--dostercios { grid-column: 1 / -1; }
    .pieza--tercio, .pieza--cuarto { grid-column: span 6; }
    .pieza--sexto { grid-column: span 4; }
    .pieza--desfase { margin-top: 0; }
    .bloque-cita { max-width: none; }
    .rejilla { grid-template-columns: 1fr 1fr; }
    .rejilla-item, .rejilla-item.ancha { grid-column: 1 / -1; }
    .rejilla-item.estrecha { grid-column: span 1; }
    .rejilla-item:nth-child(4n + 2):not(.ancha):not(.estrecha) { margin-top: 0; }
  }
</style>
