---
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import Tarjeta from '../components/Tarjeta.astro';
import { t, url, otroIdioma, type Idioma } from '../i18n';
import { CONTACTO } from '../i18n/comun';
import { getProyectos } from '../lib/proyectos';

interface Props { lang: Idioma }
const { lang } = Astro.props;
const tx = t(lang);
const proyectos = await getProyectos(lang);
const destacados = proyectos.filter((p) => p.destacado);
const e = tx.inicio.etiquetas;
const pf = tx.inicio.perfil;
---

<Base lang={lang} actual="inicio" urlOtroIdioma={url(otroIdioma(lang), 'inicio')}>
  <!-- 1 · Nombre a todo el ancho + frase centrada (estilo Fuego) -->
  <section class="marca margen">
    <h1 class="marca-h">
      <span class="titular marca-nombre" data-fit="1" data-fit-max="38vh" data-split="letras">{CONTACTO.firma}</span>
      <span class="sr-only"> — {e[0]} · {e[1]}</span>
    </h1>
    <span class="mini marca-sup" aria-hidden="true">({e[2]})</span>
    <p class="marca-frase" data-split="palabras">{tx.inicio.statementIntro}</p>
  </section>

  <!-- 2 · Flores: empiezan con márgenes y crecen hasta pantalla completa -->
  <section class="flores crece" data-crece data-crece-desde="0% 3% 8% 3%" data-crece-desde-movil="0% 4% 10% 4%">
    <div class="crece-media" data-crece-media>
      <Foto carpeta="personal" archivo="portada-flores" etiqueta="Portada home · flores" arte="flores" alt="" carga="eager" sizes="100vw" ancho={2600} parallax />
    </div>
    <div class="flores-pie mini" data-crece-pie>
      <span>{e[0]}<br />{e[1]}</span>
      <span>{e[3]}</span>
    </div>
  </section>

  <!-- 3 · Cita: quién soy, con enlace pequeño de color -->
  <section class="cita margen">
    <div class="cita-fila">
      <p class="cita-txt" data-split="palabras">“{pf.texto}”</p>
      <a class="enlace-color cita-link" href={url(lang, 'sobre')}>{tx.inicio.indice[1].enlace} →</a>
    </div>
    <div class="cita-listas">
      <div data-reveal>
        <p class="mini gris">{pf.izquierda}</p>
        <ul class="mini">{pf.listaIzquierda.map((x) => <li>{x}</li>)}</ul>
      </div>
      <div data-reveal>
        <p class="mini gris">{pf.derecha}</p>
        <ul class="mini">{pf.listaDerecha.map((x) => <li>{x}</li>)}</ul>
      </div>
    </div>
  </section>

  <!-- 4 · Statement fijado: Marca. / Estrategia. / Movimiento. -->
  <section class="statement" data-statement aria-label={tx.inicio.palabras.map((w) => w.palabra).join(', ')}>
    <div class="st-sticky margen">
      <p class="mini">{tx.inicio.queHago}</p>
      <span class="mini st-contador" aria-hidden="true"><span data-contador>01</span> / {String(tx.inicio.palabras.length).padStart(2, '0')}</span>
      <div class="st-palabras">
        {
          tx.inicio.palabras.map((w) => (
            <div class="st-item">
              <h2 class="titular st-palabra" data-palabra data-fit="1" data-fit-max="46vh" data-fit-medir="600,100">{w.palabra}.</h2>
              <p class="st-texto" data-palabra-texto>{w.texto}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 5 · Trabajo seleccionado: carrusel horizontal fijado -->
  <section class="destacados" data-horizontal aria-labelledby="titulo-trabajo">
    <div class="h-pin" data-horizontal-pin>
      <div class="h-contenido" data-horizontal-contenido>
        <div class="h-titulo" data-horizontal-titulo>
          <p class="mini">{tx.ui.nav.trabajo}</p>
          <h2 id="titulo-trabajo" class="titular h-h2"><span data-fit="0.94" data-fit-max="30vh" data-split="letras">{tx.inicio.trabajoTitulo}</span></h2>
        </div>
        <ul class="h-pista" data-horizontal-pista>
          {
            destacados.map((p, i) => (
              <li class:list={['h-item', { 'h-item--vertical': p.vertical }]}>
                <Tarjeta p={p} lang={lang} indice={i} />
              </li>
            ))
          }
          <li class="h-item h-final">
            <a href={url(lang, 'trabajo')} class="h-todo" data-cursor={tx.ui.ver}>
              <span class="mini gris">{String(proyectos.length).padStart(2, '0')} {tx.ui.proyectos}</span>
              <span class="h-todo-txt">{tx.ui.verTodo}</span>
              <span class="h-flecha" aria-hidden="true">→</span>
            </a>
          </li>
        </ul>
      </div>
      <div class="h-progreso" aria-hidden="true"><span data-horizontal-progreso></span></div>
    </div>
  </section>

  <!-- 6 · Índice gigante con punto final (estilo Fuego) -->
  <nav class="indice margen" aria-label={tx.ui.indice}>
    <ul>
      {
        tx.inicio.indice.map((it) => (
          <li data-reveal>
            <a href={url(lang, it.clave as 'trabajo' | 'sobre' | 'contacto')} class="indice-a">
              <span class="titular indice-h">{it.titulo}.</span>
              <span class="enlace-color indice-link">{it.enlace} →</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</Base>

<style>
  /* ---------- 1 · Nombre ---------- */
  .marca { position: relative; padding-top: calc(var(--cabecera) + 2.5vh); padding-bottom: clamp(3rem, 9vh, 7rem); }
  .marca-h { display: block; font-weight: 500; }
  .marca-nombre { display: inline-block; }
  .marca-sup { position: absolute; right: var(--margen); top: calc(var(--cabecera) + 1vh); }
  .marca-frase {
    max-width: 19ch;
    margin: clamp(2rem, 6vh, 4.5rem) auto 0;
    text-align: center;
    font-size: clamp(1.9rem, 1rem + 2.8vw, 4rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  /* ---------- 2 · Flores ---------- */
  .crece { position: relative; height: 100vh; height: 100svh; }
  .crece-media { position: absolute; inset: 0; will-change: clip-path; }
  :global(html:not(.con-movimiento)) .crece-media { inset: 0 var(--margen); }
  .flores-pie {
    position: absolute;
    left: var(--margen);
    right: var(--margen);
    bottom: 1.3rem;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    color: #fff;
    mix-blend-mode: difference;
  }

  /* ---------- 3 · Cita ---------- */
  .cita { padding-block: var(--seccion); }
  .cita-fila { display: grid; grid-template-columns: 1fr auto; gap: 2rem; align-items: start; }
  .cita-txt {
    max-width: 26ch;
    font-size: clamp(1.8rem, 1rem + 2.5vw, 3.8rem);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.04em;
  }
  .cita-link { padding-top: 0.8rem; max-width: 9rem; }
  .cita-listas { display: flex; justify-content: space-between; gap: 2rem; margin-top: clamp(3rem, 8vh, 6rem); }
  .cita-listas > div:last-child { text-align: right; }
  .cita-listas p { margin-bottom: 0.6rem; }

  /* ---------- 4 · Statement ---------- */
  .st-sticky { position: relative; padding-block: var(--seccion); }
  .st-contador { position: absolute; right: var(--margen); top: var(--seccion); }
  .st-item { margin-top: 3rem; }
  .st-item:nth-child(2) .st-palabra { color: var(--color-firma); }
  .st-texto { max-width: 30ch; margin-top: 1rem; font-size: 1.15rem; line-height: 1.25; letter-spacing: -0.015em; }

  :global(html.con-movimiento) .statement { height: 360vh; }
  :global(html.con-movimiento) .st-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    padding-block: calc(var(--cabecera) + 1.5rem) 2rem;
    overflow: hidden;
  }
  :global(html.con-movimiento) .st-palabras { position: absolute; inset: 0; padding-inline: var(--margen); }
  :global(html.con-movimiento) .st-item {
    position: absolute;
    inset: 0 var(--margen);
    margin: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }
  :global(html.con-movimiento) .st-texto { position: absolute; left: 50%; bottom: 2.5rem; transform: translateX(-50%); text-align: center; }
  :global(html.con-movimiento) .st-sticky > .mini:first-child { position: absolute; left: var(--margen); top: calc(var(--cabecera) + 1.5rem); }
  :global(html.con-movimiento) .st-contador { top: calc(var(--cabecera) + 1.5rem); }

  /* ---------- 5 · Carrusel horizontal ---------- */
  .destacados { position: relative; }
  .h-pin { position: relative; overflow: hidden; }
  :global(html.con-movimiento) .h-pin { height: 100vh; height: 100svh; }
  .h-titulo { padding: calc(var(--cabecera) + 3vh) var(--margen) 5vh; text-align: center; }
  .h-titulo .mini { margin-bottom: 1.5vh; }
  .h-h2 { display: flex; justify-content: center; }
  .h-pista {
    display: flex;
    align-items: flex-start;
    gap: var(--hueco);
    padding: 0 var(--margen) 2rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
  }
  .h-pista > li { scroll-snap-align: start; }
  :global(.destacados.activo) .h-pista { overflow: visible; width: max-content; }
  .h-item { flex: none; width: min(25vw, 64vh); }
  .h-item--vertical { width: min(26vw, 48vh); }
  .h-final { align-self: stretch; display: flex; }
  .h-todo {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    min-height: min(19vw, 48vh);
    padding: 1.2rem;
    border: 1px solid currentColor;
    border-radius: 0.4rem;
    transition: background 0.4s, color 0.4s;
  }
  .h-todo:hover { background: var(--color-tinta); color: var(--color-fondo); }
  .h-todo-txt { font-size: clamp(1.4rem, 2vw, 2.4rem); font-weight: 500; line-height: 0.95; letter-spacing: -0.045em; }
  .h-flecha { font-size: 2.4rem; align-self: flex-end; transition: transform 0.4s var(--ease); }
  .h-todo:hover .h-flecha { transform: translateX(0.4rem); }
  .h-progreso { display: none; }
  :global(html.con-movimiento) .h-progreso {
    display: block;
    position: absolute;
    left: var(--margen);
    right: var(--margen);
    bottom: 1.4rem;
    height: 1px;
    background: var(--color-linea);
  }
  .h-progreso span { display: block; height: 100%; background: var(--color-firma); transform: scaleX(0); transform-origin: left; }

  /* ---------- 6 · Índice ---------- */
  .indice { padding-top: var(--seccion); }
  .indice-a { display: inline-flex; align-items: flex-end; gap: 0.8rem; }
  .indice-h {
    font-size: clamp(4rem, 15vw, 17rem);
    line-height: 0.92;
    transition: color 0.35s;
  }
  .indice-link { padding-bottom: 1.6vw; max-width: 9rem; }
  .indice-a:hover .indice-h { color: var(--color-firma); }

  @media (max-width: 860px) {
    .marca-sup { display: none; }
    .cita-fila { grid-template-columns: 1fr; }
    .h-item { width: 72vw; }
    .h-item--vertical { width: 62vw; }
    .h-todo { min-height: 50vw; }
    .indice-a { flex-direction: column; align-items: flex-start; gap: 0.3rem; margin-bottom: 1.2rem; }
    .indice-link { padding-bottom: 0; }
  }
</style>
