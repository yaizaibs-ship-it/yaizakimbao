---
import '@fontsource-variable/geist';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import { t, otroIdioma, conBase, url, type Idioma, type ClaveRuta } from '../i18n';
import { CONTACTO } from '../i18n/comun';
import retrato from '../assets/personal/retrato.jpg';

interface Props {
  lang: Idioma;
  actual: ClaveRuta;
  /** URL de esta página en el otro idioma (para el selector ES/EN y hreflang) */
  urlOtroIdioma: string;
  titulo?: string;
  descripcion?: string;
  imagenOG?: ImageMetadata;
  acento?: string;
  acentoTexto?: string;
  /** Datos del proyecto para Google (solo en los casos) */
  proyecto?: { anio?: string; cliente?: string; disciplinas?: string[] };
  /** true = que Google no la indexe (p. ej. casos «Work in progress») */
  noindex?: boolean;
}

const { lang, actual, urlOtroIdioma, titulo, descripcion, imagenOG, acento, acentoTexto, proyecto, noindex } = Astro.props;
const tx = t(lang);
const otro = otroIdioma(lang);
const tituloFinal = titulo ? `${titulo} — ${CONTACTO.firma}` : tx.meta.tituloSitio;
const descFinal = descripcion ?? tx.meta.descripcion;
const site = Astro.site ?? new URL('https://example.com');
const canonica = new URL(Astro.url.pathname, site).href;
const alterna = new URL(urlOtroIdioma, site).href;
const urlEs = lang === 'es' ? canonica : alterna;
const urlEn = lang === 'en' ? canonica : alterna;

// Ficha para Google y asistentes de IA: quién es Yaiza y dónde encontrarla.
const urlInicio = new URL(conBase(`/${lang}/`), site).href;
const fotoRetrato = await getImage({ src: retrato, width: 800, format: 'jpg' });
const fichaPersona = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${site.origin}/#persona`,
  name: CONTACTO.nombre,
  alternateName: CONTACTO.firma,
  jobTitle: lang === 'es' ? 'Diseñadora visual y estratega de comunicación' : 'Visual designer and communication strategist',
  description: tx.meta.descripcion,
  url: urlInicio,
  image: new URL(fotoRetrato.src, site).href,
  email: `mailto:${CONTACTO.email}`,
  sameAs: [CONTACTO.linkedin, CONTACTO.instagram],
  knowsAbout: ['Branding', 'Diseño gráfico', 'Visual design', 'Communication strategy', 'Motion graphics', 'Social media', 'UX/UI', 'Upcycling'],
  knowsLanguage: ['es', 'en', 'it', 'ca'],
  homeLocation: { '@type': 'Country', name: lang === 'es' ? 'España' : 'Spain' },
  address: { '@type': 'PostalAddress', addressCountry: 'ES' },
};
// Ficha de la web (nombre del sitio en Google)
const fichaWeb = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.origin}/#web`,
  name: CONTACTO.firma,
  alternateName: ['yaizakimbao.com', CONTACTO.nombre],
  url: `${site.origin}/`,
  inLanguage: ['es', 'en'],
  publisher: { '@id': `${site.origin}/#persona` },
};

let og = new URL(conBase('/og-default.png'), site).href;
if (imagenOG) {
  const img = await getImage({ src: imagenOG, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
  og = new URL(img.src, site).href;
}
// En los proyectos: ficha del trabajo y migas de pan (Inicio › Trabajo › Proyecto)
const fichasExtra: object[] = [];
if (actual === 'proyecto' && titulo) {
  fichasExtra.push({
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: titulo,
    headline: titulo,
    description: descFinal,
    url: canonica,
    image: og,
    inLanguage: lang,
    ...(proyecto?.anio ? { dateCreated: proyecto.anio } : {}),
    ...(proyecto?.disciplinas?.length ? { keywords: proyecto.disciplinas.join(', ') } : {}),
    ...(proyecto?.cliente ? { sourceOrganization: { '@type': 'Organization', name: proyecto.cliente } } : {}),
    author: { '@type': 'Person', name: CONTACTO.nombre, alternateName: CONTACTO.firma, url: urlInicio },
  });
  fichasExtra.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: tx.ui.nav.inicio, item: urlInicio },
      { '@type': 'ListItem', position: 2, name: tx.ui.nav.trabajo, item: new URL(url(lang, 'trabajo'), site).href },
      { '@type': 'ListItem', position: 3, name: titulo, item: canonica },
    ],
  });
}
const estiloAcento = acento ? `--accent:${acento};--accent-texto:${acentoTexto ?? '#fff'}` : undefined;
---

<!doctype html>
<html lang={lang} data-lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{tituloFinal}</title>
    <meta name="description" content={descFinal} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonica} />
    <link rel="alternate" hreflang="es" href={urlEs} />
    <link rel="alternate" hreflang="en" href={urlEn} />
    <link rel="alternate" hreflang="x-default" href={urlEs} />
    <link rel="icon" href={conBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={conBase('/favicon-48.png')} type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href={conBase('/apple-touch-icon.png')} />
    <link rel="manifest" href={conBase('/site.webmanifest')} />
    <meta name="author" content={`${CONTACTO.nombre} (${CONTACTO.firma})`} />
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large" />}
    <link rel="sitemap" href={conBase('/sitemap-index.xml')} />
    <meta name="theme-color" content="#f4f1ec" />

    <!-- Open Graph / redes -->
    <meta property="og:type" content={actual === 'proyecto' ? 'article' : 'website'} />
    <meta property="og:site_name" content={CONTACTO.firma} />
    <meta property="og:title" content={tituloFinal} />
    <meta property="og:description" content={descFinal} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={titulo ?? tx.meta.tituloSitio} />
    <meta property="og:locale" content={tx.meta.locale} />
    <meta property="og:locale:alternate" content={t(otro).meta.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(fichaPersona)} />
    {actual === 'inicio' && <script type="application/ld+json" set:html={JSON.stringify(fichaWeb)} />}
    {fichasExtra.map((f) => <script type="application/ld+json" set:html={JSON.stringify(f)} />)}

    <!-- Si el visitante elige idioma, se recuerda para la próxima visita -->
    <script is:inline define:vars={{ lang }}>
      try { localStorage.setItem('idioma', lang); } catch (e) {}
      document.documentElement.classList.add('js');
      // Intro con contador: solo la primera vez en la sesión y si no se pide menos movimiento
      try {
        if (!sessionStorage.getItem('intro-vista') && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('con-intro');
        }
        // Lo que se revela con animación empieza oculto (sin parpadeo).
        // Si el script de animaciones fallara, se muestra igualmente a los 4 s.
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('pre-anim');
          setTimeout(function () { document.documentElement.classList.remove('pre-anim'); }, 4000);
        }
      } catch (e) {}
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body style={estiloAcento} data-pagina={actual}>
    <a class="saltar" href="#contenido">{tx.ui.saltar}</a>
    <div class="intro" data-intro aria-hidden="true">
      <span class="firma intro-firma" data-intro-firma>{CONTACTO.firma}</span>
      <span class="intro-num" data-intro-num>000</span>
      <span class="mini intro-txt">{tx.inicio.etiquetas[0]} — {tx.inicio.etiquetas[1]}</span>
    </div>
    <div class="cursor" data-cursor-el aria-hidden="true"><span data-cursor-texto></span></div>
    <span id="top"></span>
    <Cabecera lang={lang} actual={actual} urlOtroIdioma={urlOtroIdioma} />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Pie lang={lang} />
    <script>
      import { iniciar, detener } from '../scripts/movimiento';
      document.addEventListener('astro:page-load', iniciar);
      document.addEventListener('astro:before-swap', detener);
      // Al cambiar de página: lo que se va a revelar vuelve a empezar oculto (sin parpadeo)
      document.addEventListener('astro:after-swap', () => {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const html = document.documentElement;
        html.classList.add('pre-anim');
        setTimeout(() => html.classList.remove('pre-anim'), 4000);
      });
    </script>
  </body>
</html>
