---
// Página de error (enlace roto o dirección mal escrita). GitHub Pages la sirve sola.
import Base from '../layouts/Base.astro';
import BotonProyecto from '../components/BotonProyecto.astro';
import { t, url } from '../i18n';

const es = t('es').meta.error404;
const en = t('en').meta.error404;
---

<Base lang="es" actual="contacto" urlOtroIdioma={url('en', 'inicio')} titulo="404" descripcion={es.texto} noindex>
  <section class="e404 margen">
    <p class="mini">Error 404</p>
    <h1 class="e404-h">{es.titulo}</h1>
    <p class="e404-p">{es.texto}</p>
    <p class="e404-p e404-en" lang="en">{en.titulo}. {en.texto}</p>
    <div class="e404-botones">
      <a class="enlace-color" href={url('es', 'inicio')}>← {es.volver}</a>
      <a class="enlace-color" href={url('en', 'inicio')} lang="en">← {en.volver}</a>
      <BotonProyecto lang="es" />
    </div>
  </section>
</Base>

<style>
  .e404 { min-height: 80vh; display: grid; align-content: center; gap: 1.4rem; padding-block: calc(var(--cabecera) + 3rem) var(--seccion); }
  .e404-h { max-width: 14ch; font-size: var(--t-grande); font-weight: 500; line-height: 0.95; letter-spacing: -0.05em; }
  .e404-p { max-width: 40ch; font-size: var(--t-medio); line-height: 1.15; letter-spacing: -0.02em; font-weight: 500; }
  .e404-en { color: var(--color-gris); font-size: var(--t-cuerpo); }
  .e404-botones { display: flex; flex-wrap: wrap; align-items: center; gap: 1.6rem; margin-top: 0.8rem; }
</style>
