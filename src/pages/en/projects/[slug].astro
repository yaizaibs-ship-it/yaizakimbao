---
// Página de cada caso (en). El diseño está en src/views/Caso.astro
import Caso from '../../../views/Caso.astro';
import CasoEnProceso from '../../../views/CasoEnProceso.astro';
import { getProyectos } from '../../../lib/proyectos';

export async function getStaticPaths() {
  const lista = await getProyectos('en');
  return lista.map((p) => ({ params: { slug: p.slug }, props: { enProceso: p.enProceso } }));
}
const { slug } = Astro.params;
const { enProceso } = Astro.props;
---

{enProceso ? <CasoEnProceso lang="en" slug={slug} /> : <Caso lang="en" slug={slug} />}
