---
// Página de cada caso (en). El diseño está en src/views/Caso.astro
import Caso from '../../../views/Caso.astro';
import { getProyectos } from '../../../lib/proyectos';

export async function getStaticPaths() {
  const lista = await getProyectos('en');
  return lista.map((p) => ({ params: { slug: p.slug } }));
}
const { slug } = Astro.params;
---

<Caso lang="en" slug={slug} />
