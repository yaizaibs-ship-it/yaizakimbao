---
// La raíz «/» lleva al idioma que el visitante eligió la última vez (o al español).
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Yaiza Kimbao</title>
    <meta name="robots" content="noindex" />
    <link rel="alternate" hreflang="es" href="/es/" />
    <link rel="alternate" hreflang="en" href="/en/" />
    <script is:inline>
      (function () {
        var lang = 'es';
        try {
          var guardado = localStorage.getItem('idioma');
          if (guardado === 'en' || guardado === 'es') lang = guardado;
        } catch (e) {}
        location.replace('/' + lang + '/');
      })();
    </script>
    <meta http-equiv="refresh" content="1; url=/es/" />
  </head>
  <body>
    <p><a href="/es/">Español</a> · <a href="/en/">English</a></p>
  </body>
</html>
